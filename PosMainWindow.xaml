<Window x:Class="POSPro.Views.PosMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POS Pro - Nouvelle Vente" 
        Height="768" Width="1280"
        WindowState="Maximized"
        Background="#EAEAEA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- نمط أزرار الإجراءات السريعة -->
        <Style x:Key="ActionSquareButton" TargetType="Button">
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- نمط أزرار العملاء (Client 1 - 4) -->
        <Style x:Key="ClientTabButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- شريط القوائم العلوي -->
            <RowDefinition Height="Auto"/>
            <!-- ترويسة الفاتورة والزبون -->
            <RowDefinition Height="Auto"/>
            <!-- جدول المنتجات -->
            <RowDefinition Height="240"/>
            <!-- شريط التحكم والعملاء المتعددين -->
            <RowDefinition Height="Auto"/>
            <!-- المنطقة السفلية (الباقي Rendu + الشعار + الساعة) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. شريط القوائم العلوي -->
        <Menu Grid.Row="0" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="4,2">
            <MenuItem Header="Fichier"/>
            <MenuItem Header="Recherche"/>
            <MenuItem Header="Calculatrice"/>
            <MenuItem Header="Importer"/>
            <MenuItem Header="Afficher"/>
            <MenuItem Header="عربي"/>
        </Menu>

        <!-- 2. ترويسة الفاتورة والبيانات العلوية -->
        <Border Grid.Row="1" Background="#E5E5E5" Padding="10,8" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- عنوان Nouvelle Vente -->
                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Nouvelle Vente" FontSize="26" FontWeight="SemiBold" Foreground="#222222"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="Anonyme" Height="24" VerticalContentAlignment="Center" Padding="5,0" Background="White" BorderBrush="#B0B0B0"/>
                        <Button Grid.Column="1" Content="..." Height="24" Margin="2,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- نوع السعر وحالة الاتصال -->
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="5,0">
                    <Border Background="#D9E8FB" BorderBrush="#99BCE8" BorderThickness="1" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                        <TextBlock Text="Public" Foreground="#15428B" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#28A745" Margin="0,0,6,0"/>
                        <TextBlock Text="Situation correcte" FontSize="12" Foreground="#333333"/>
                    </StackPanel>
                </StackPanel>

                <!-- مربعات الإحصائيات الصغيرة (Remise, Marge, N° BL, N° Ticket) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,2">
                    <Border BorderBrush="#BDBDBD" BorderThickness="1" Background="White" Padding="6,3" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="Remise (%)" FontSize="10" Foreground="#666"/>
                            <TextBlock Text="0 %" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#BDBDBD" BorderThickness="1" Background="White" Padding="6,3" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="Marge/FM" FontSize="10" Foreground="#666"/>
                            <TextBlock Text="%" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#BDBDBD" BorderThickness="1" Background="White" Padding="6,3" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="N° BL" FontSize="10" Foreground="#666"/>
                            <TextBlock Text="19157/26" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#BDBDBD" BorderThickness="1" Background="White" Padding="6,3" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="N° Ticket" FontSize="10" Foreground="#666"/>
                            <TextBlock Text="001/26" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- التاريخ والبحث السريع (Liste F10) -->
                <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Border Background="White" BorderBrush="#BDBDBD" BorderThickness="1" Padding="8,3" Margin="0,0,0,6">
                        <TextBlock Text="15/11/2026" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="Liste (F10)" Padding="10,3" Background="#F8F8F8" BorderBrush="#BDBDBD"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. جدول المنتجات (DataGrid) -->
        <DataGrid Grid.Row="2" x:Name="CartDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E0E0E0"
                  Background="White"
                  RowHeight="28"
                  FontSize="13"
                  SelectionMode="Single">
            <DataGrid.Resources>
                <!-- تلوين الصف المحدد بالأصفر كما في الصورة -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFF176"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#000000"/>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Désignation" Binding="{Binding ProductName}" Width="2.5*" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Ref" Binding="{Binding Reference}" Width="120"/>
                <DataGridTextColumn Header="Famille" Binding="{Binding Category}" Width="160"/>
                <DataGridTextColumn Header="Qté" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="PRIX U. HT" Binding="{Binding UnitPrice, StringFormat={}{0:N2} DA}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. شريط التحكم الأوسط (الزبائن المتعددين + أزرار الخزينة + أزرار التعديل) -->
        <Border Grid.Row="3" Background="#E6E6E6" BorderBrush="#CCCCCC" BorderThickness="0,1,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- تبويبات العملاء (Client 1..4) -->
                    <ColumnDefinition Width="130"/>
                    <!-- أزرار الطباعة والخزينة + ملخص آخر عملية -->
                    <ColumnDefinition Width="*"/>
                    <!-- أزرار الإضافة والحذف وتغيير السعر -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- قائمة العملاء المعلقين -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Button Content="✔ Client 1 (F1)" Style="{StaticResource ClientTabButton}" Background="#DCEBFC" FontWeight="Bold"/>
                    <Button Content="Client 2 (F2)" Style="{StaticResource ClientTabButton}"/>
                    <Button Content="Client 3 (F3)" Style="{StaticResource ClientTabButton}"/>
                    <Button Content="Client 4 (F4)" Style="{StaticResource ClientTabButton}"/>
                </StackPanel>

                <!-- أزرار Caisse / Annuler / Dernier Ticket + سطر المعلومات -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Width="115" Height="52" Margin="0,0,6,0" Background="#F7F7F7" BorderBrush="#BDBDBD">
                            <StackPanel>
                                <TextBlock Text="💵" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="Caisse (Espace)" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Width="125" Height="52" Margin="0,0,6,0" Background="#F7F7F7" BorderBrush="#BDBDBD">
                            <StackPanel>
                                <TextBlock Text="🚫" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="Annuler Vente (F9)" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Width="125" Height="52" Margin="0,0,6,0" Background="#F7F7F7" BorderBrush="#BDBDBD">
                            <StackPanel>
                                <TextBlock Text="🖨️" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="Dernier Ticket (F12)" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- شريط ملخص آخر عملية بيع -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Dernière Vente N° 133274   17:01   Total: 430.00 DA   Versé: 500.00 DA   Rendu: 70.00 DA" 
                                   FontSize="11.5" Foreground="#444444"/>
                    </StackPanel>
                </StackPanel>

                <!-- أزرار التحكم بالصفوف على اليمين -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ActionSquareButton}">
                            <StackPanel>
                                <TextBlock Text="★" FontSize="18" HorizontalAlignment="Center" Foreground="#333"/>
                                <TextBlock Text="Favoris" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionSquareButton}">
                            <StackPanel>
                                <TextBlock Text="🏷️" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="PRIX" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionSquareButton}">
                            <StackPanel>
                                <TextBlock Text="−" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1E62B5"/>
                                <TextBlock Text="Supprimer" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionSquareButton}">
                            <StackPanel>
                                <TextBlock Text="+" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1E62B5"/>
                                <TextBlock Text="Ajouter" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <CheckBox Content="Articles Non vendus" HorizontalAlignment="Left" Margin="6,6,0,0" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. المنطقة السفلية الكبيرة (Rendu + الشعار الأوسط + الساعة + عدد المواد) -->
        <Grid Grid.Row="4" Background="#EFEFEF" Padding="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- اليسار: الباقي (Rendu) وعدد المواد -->
            <Grid Grid.Column="0">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="Rendu" FontSize="18" Foreground="#1A5FB4" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtRendu" Text="70.00 DA" FontSize="34" FontWeight="Bold" Foreground="#111111" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="Dernière Vente" FontSize="11" Foreground="#666666"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Nombre d'Articles : " FontSize="14" Foreground="#333333" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtArticleCount" Text="3" FontSize="18" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- الوسط: شعار المتجر + الساعة الرقمية الكبيرة -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="170" Height="170" CornerRadius="85" BorderBrush="#6BBF59" BorderThickness="10" Background="Transparent" Margin="0,0,0,15">
                    <TextBlock Text="ق" FontSize="95" FontWeight="Bold" Foreground="#4A4A4A" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-15,0,0"/>
                </Border>
                <TextBlock x:Name="TxtClock" Text="17:10" FontSize="32" FontWeight="SemiBold" Foreground="#333333" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- اليمين: الإجمالي الكلي -->
            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <TextBlock Text="TOTAL À PAYER" FontSize="13" Foreground="#666666" HorizontalAlignment="Right"/>
                <TextBlock x:Name="TxtGrandTotal" Text="1 180.00 DA" FontSize="36" FontWeight="Bold" Foreground="#1B5E20" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
